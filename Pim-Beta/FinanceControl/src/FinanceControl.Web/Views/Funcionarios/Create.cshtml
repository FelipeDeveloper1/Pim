@model Funcionario
@{ ViewData["Title"] = "Novo funcionário"; }
<div class="page-header"><h1>Novo funcionário</h1></div>
<div class="table-panel">
    <form asp-action="Create" method="post">@Html.AntiForgeryToken()
        <div class="form-group"><label asp-for="Nome"></label><input asp-for="Nome" class="form-control" /></div>
        <div class="form-group"><label asp-for="Cargo"></label><input asp-for="Cargo" class="form-control" /></div>
        <div class="form-group"><label asp-for="Salario"></label><input asp-for="Salario" class="form-control" /></div>
        <div class="form-group"><label asp-for="DataAdmissao"></label><input asp-for="DataAdmissao" type="date" class="form-control" /></div>
        <button type="submit" class="btn-primary" style="width:auto">Salvar</button>
    </form>
</div>
