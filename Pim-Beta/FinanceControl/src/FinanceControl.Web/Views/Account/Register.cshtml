@model RegistroDto
@{
    ViewData["Title"] = "Criar conta";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card auth-card-wide">
        <h1>Criar conta</h1>
        <p class="subtitle">Preencha os dados para acessar o FinanceControl</p>

        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="NomeCompleto"></label>
                <input asp-for="NomeCompleto" class="form-control" />
                <span asp-validation-for="NomeCompleto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NomeUsuario"></label>
                <input asp-for="NomeUsuario" class="form-control" autocomplete="username" />
                <span asp-validation-for="NomeUsuario" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Senha"></label>
                <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmarSenha"></label>
                <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary">Criar conta</button>
        </form>

        <p class="auth-link"><a asp-action="Login">Voltar ao login</a></p>
    </div>
</div>
