@model Despesa
@{ ViewData["Title"] = "Nova despesa"; }
<div class="page-header"><h1>Nova despesa</h1></div>
<div class="table-panel">
    <form asp-action="Create" method="post">@Html.AntiForgeryToken()
        <div class="form-group"><label asp-for="Descricao"></label><input asp-for="Descricao" class="form-control" /></div>
        <div class="form-group"><label asp-for="Valor"></label><input asp-for="Valor" class="form-control" /></div>
        <div class="form-group"><label asp-for="Data"></label><input asp-for="Data" type="date" class="form-control" /></div>
        <div class="form-group"><label asp-for="CategoriaId"></label><select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId"></select></div>
        <div class="form-group"><label asp-for="ContaId"></label><select asp-for="ContaId" class="form-control" asp-items="ViewBag.ContaId"></select></div>
        <button type="submit" class="btn-primary" style="width:auto">Salvar</button>
    </form>
</div>
