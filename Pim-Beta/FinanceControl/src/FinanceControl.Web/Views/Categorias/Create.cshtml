@model Categoria
@{ ViewData["Title"] = "Nova categoria"; }
<div class="page-header"><h1>Nova categoria</h1></div>
<div class="table-panel">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-group"><label asp-for="Nome"></label><input asp-for="Nome" class="form-control" /></div>
        <div class="form-group"><label asp-for="Tipo"></label><select asp-for="Tipo" class="form-control" asp-items="Html.GetEnumSelectList<TipoCategoria>()"></select></div>
        <button type="submit" class="btn-primary" style="width:auto">Salvar</button>
        <a asp-action="Index">Cancelar</a>
    </form>
</div>
