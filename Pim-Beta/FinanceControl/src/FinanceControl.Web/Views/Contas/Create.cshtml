@model Conta
@{ ViewData["Title"] = "Nova conta"; }
<div class="page-header"><h1>Nova conta</h1></div>
<div class="table-panel">
    <form asp-action="Create" method="post">@Html.AntiForgeryToken()
        <div class="form-group"><label asp-for="Nome"></label><input asp-for="Nome" class="form-control" /></div>
        <div class="form-group"><label asp-for="Descricao"></label><input asp-for="Descricao" class="form-control" /></div>
        <div class="form-group"><label asp-for="SaldoInicial"></label><input asp-for="SaldoInicial" class="form-control" /></div>
        <div class="form-group"><label asp-for="Ativa"></label><input asp-for="Ativa" type="checkbox" /></div>
        <button type="submit" class="btn-primary" style="width:auto">Salvar</button>
    </form>
</div>
