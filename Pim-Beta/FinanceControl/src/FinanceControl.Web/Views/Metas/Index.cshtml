@model IEnumerable<Meta>
@{
    ViewData["Title"] = "Metas";
    var cultura = new System.Globalization.CultureInfo("pt-BR");
    var abrirModal = string.Equals(TempData["AbrirModalMeta"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet" href="~/css/employer.css" asp-append-version="true" />
}

<div class="page-header">
    <h1>Metas</h1>
    <button type="button" class="btn-new" id="btnAbrirModalMeta">Nova meta</button>
</div>

<div class="table-panel">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome da meta</th>
                <th>Valor objetivo</th>
                <th>Valor atual</th>
                <th>Data limite</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="table-empty">Nenhuma meta cadastrada. Clique em Nova meta.</td></tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Titulo</td>
                <td>@item.ValorAlvo.ToString("C", cultura)</td>
                <td>@item.ValorAtual.ToString("C", cultura)</td>
                <td>@(item.DataLimite?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>
                    <a class="btn-sm btn-edit" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-sm btn-delete" onclick="return confirm('Excluir esta meta?')">Excluir</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal-overlay_employer" id="modalMeta" style="display:none">
    <div class="modal modal-meta">
        <div class="modal-top">
            <h2>Nova meta</h2>
            <span class="modal-close" id="btnFecharModalMeta" role="button" tabindex="0" aria-label="Fechar">✕</span>
        </div>
        <div class="modal-content">
            <form asp-action="Create" method="post" id="formNovaMeta">
                @Html.AntiForgeryToken()
                <div class="input-group">
                    <label for="metaTitulo">Nome da meta</label>
                    <input id="metaTitulo" name="Titulo" class="form-control" placeholder="Ex.: Viagem de férias" required maxlength="120" />
                </div>
                <div class="input-group">
                    <label>Valor objetivo</label>
                    <input name="ValorAlvo" type="number" step="0.01" min="0.01" class="form-control" placeholder="0,00" required />
                </div>
                <div class="input-group">
                    <label>Valor atual</label>
                    <input name="ValorAtual" type="number" step="0.01" min="0" class="form-control" value="0" />
                </div>
                <div class="input-group">
                    <label>Data limite</label>
                    <input name="DataLimite" type="date" class="form-control" required />
                </div>
                <button type="submit" class="btn-cadastrar">Cadastrar meta</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('modalMeta');
            const abrir = document.getElementById('btnAbrirModalMeta');
            const fechar = document.getElementById('btnFecharModalMeta');

            function mostrar() { modal.style.display = 'flex'; }
            function ocultar() { modal.style.display = 'none'; }

            abrir?.addEventListener('click', mostrar);
            fechar?.addEventListener('click', ocultar);
            modal?.addEventListener('click', (e) => { if (e.target === modal) ocultar(); });

            @if (abrirModal)
            {
                <text>mostrar();</text>
            }
        })();
    </script>
}
